{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-5",
  "permission": {
    "edit": "allow",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      ".taskrail/bin/taskrail": "allow",
      ".taskrail/bin/taskrail *": "allow",
      "./.taskrail/bin/taskrail": "allow",
      "./.taskrail/bin/taskrail *": "allow",
      "@REPO@/.taskrail/bin/taskrail": "allow",
      "@REPO@/.taskrail/bin/taskrail *": "allow",
      "@REPO@/.worktrees/*/.taskrail/bin/taskrail": "allow",
      "@REPO@/.worktrees/*/.taskrail/bin/taskrail *": "allow",
      "git": "allow",
      "git *": "allow",
      "python3 -m unittest": "allow",
      "python3 -m unittest *": "allow",
      "python3 -m compileall": "allow",
      "python3 -m compileall *": "allow",
      "python3 -m wordstat": "allow",
      "python3 -m wordstat *": "allow",
      "cd": "allow",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "diff": "allow",
      "diff *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "date": "allow",
      "date *": "allow",
      "git push": "ask",
      "git push *": "ask"
    }
  }
}
